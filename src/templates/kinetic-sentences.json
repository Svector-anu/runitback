{
  "format": "runitback-template",
  "templateVersion": 1,
  "id": "kinetic-sentences",
  "name": "Kinetic sentences",
  "category": "explainer",
  "tags": [
    "text-only",
    "kinetic",
    "numbers"
  ],
  "description": "Sentences that arrive word by word on a soft mint wash: a blur-in opener, a counting hero number, four icon-led lines with one accent word, and a call to action. Footage is optional.",
  "canvas": {
    "aspect": "16:9",
    "fps": 30,
    "backgroundColor": "#fbfcfc",
    "gradient": {
      "style": "linear",
      "colors": [
        "#fbfcfc",
        "#e9fbf0",
        "#c8f5da"
      ],
      "angle": 180
    }
  },
  "durationSeconds": 19,
  "slots": [
    {
      "id": "logo",
      "kind": "image",
      "label": "Logo",
      "optional": true,
      "hint": "A square logo shown above the opening line."
    },
    {
      "id": "icon-1",
      "kind": "image",
      "label": "Icon 1",
      "optional": true,
      "hint": "A square image; it sits to the left of the sentence."
    },
    {
      "id": "icon-2",
      "kind": "image",
      "label": "Icon 2",
      "optional": true,
      "hint": "A square image; it sits to the left of the sentence."
    },
    {
      "id": "icon-3",
      "kind": "image",
      "label": "Icon 3",
      "optional": true,
      "hint": "A square image; it sits to the left of the sentence."
    },
    {
      "id": "icon-4",
      "kind": "image",
      "label": "Icon 4",
      "optional": true,
      "hint": "A square image; it sits to the left of the sentence."
    }
  ],
  "texts": [
    {
      "id": "hook",
      "label": "Opening line",
      "default": "Teams ship faster when the work explains itself",
      "style": "headline",
      "maxChars": 80,
      "maxWidth": 1500,
      "overrides": {
        "sizePx": 104,
        "color": "#14181f",
        "shadow.enabled": false
      },
      "animation": {
        "in": {
          "preset": "blur-in",
          "seconds": 0.8
        },
        "out": {
          "preset": "fade",
          "seconds": 0.3
        }
      }
    },
    {
      "id": "kicker",
      "label": "Kicker",
      "default": "INTRODUCING",
      "style": "kicker",
      "maxChars": 30,
      "overrides": {
        "sizePx": 40,
        "color": "#0ba66a"
      },
      "animation": {
        "in": {
          "preset": "fade",
          "seconds": 0.4
        },
        "out": {
          "preset": "fade",
          "seconds": 0.3
        }
      }
    },
    {
      "id": "hero",
      "label": "Big number",
      "default": "12,400+",
      "style": "numeral",
      "maxChars": 12,
      "overrides": {
        "sizePx": 340,
        "color": "#14181f",
        "shadow.enabled": false
      },
      "animation": {
        "in": {
          "preset": "count-up",
          "seconds": 1.8
        },
        "out": {
          "preset": "fade",
          "seconds": 0.3
        }
      }
    },
    {
      "id": "hero-label",
      "label": "Big number label",
      "default": "teams ship with it every week",
      "style": "subhead",
      "maxChars": 60,
      "overrides": {
        "sizePx": 64,
        "color": "#4b5563",
        "shadow.enabled": false
      },
      "animation": {
        "in": {
          "preset": "stagger-words",
          "seconds": 1.0
        },
        "out": {
          "preset": "fade",
          "seconds": 0.3
        }
      }
    },
    {
      "id": "s1",
      "label": "Sentence 1",
      "default": "Plan the whole launch in one place",
      "style": "headline",
      "maxChars": 70,
      "maxWidth": 1250,
      "overrides": {
        "sizePx": 78,
        "textAlign": "left",
        "color": "#14181f",
        "shadow.enabled": false,
        "highlightWord": 2,
        "highlightColor": "#0ba66a"
